{
  "name": "nova-launcher",
  "productName": "Nova Client",
  "version": "1.0.9",
  "description": "Lanzador de Nova Client para Minecraft 1.21.1 - 1.21.11",
  "main": "main.js",
  "author": "Nova",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/core.test.js",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.3.9",
    "minecraft-launcher-core": "^3.18.2",
    "undici": "^6.21.3"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "terser": "^5.36.0"
  },
  "build": {
    "appId": "com.nova.launcher",
    "productName": "Nova Client",
    "artifactName": "NovaClient-Setup.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/mods",
        "to": "mods",
        "filter": [
          "*.jar"
        ]
      },
      {
        "from": "resources/packs",
        "to": "packs",
        "filter": [
          "*.zip"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nova Client",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "pepeelmago2009",
      "repo": "nova-updates",
      "releaseType": "release"
    }
  }
}
